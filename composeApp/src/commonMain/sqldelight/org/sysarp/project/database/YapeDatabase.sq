CREATE TABLE yape_transaction (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    transaction_id TEXT UNIQUE NOT NULL,
    amount REAL NOT NULL,
    currency TEXT NOT NULL DEFAULT 'PEN',
    sender_name TEXT,
    sender_phone TEXT,
    message TEXT,
    transaction_type TEXT NOT NULL, -- 'received' or 'sent'
    business_name TEXT,
    created_at INTEGER NOT NULL, -- Unix timestamp
    processed_at INTEGER, -- Unix timestamp when processed
    is_processed INTEGER NOT NULL DEFAULT 0, -- 0 = false, 1 = true
    raw_notification TEXT, -- Raw notification text for debugging
    security_code TEXT -- Security code for duplicate prevention
);

-- Tabla para notificaciones de Yape sin procesar
CREATE TABLE yape_notification (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    package_name TEXT NOT NULL,
    notification_title TEXT,
    notification_text TEXT NOT NULL,
    notification_big_text TEXT,
    notification_sub_text TEXT,
    notification_info_text TEXT,
    notification_summary_text TEXT,
    notification_ticker_text TEXT,
    notification_extras TEXT, -- JSON string de todos los extras
    notification_id INTEGER NOT NULL,
    notification_tag TEXT,
    notification_key TEXT,
    notification_timestamp INTEGER NOT NULL,
    is_clearable INTEGER NOT NULL DEFAULT 1,
    is_ongoing INTEGER NOT NULL DEFAULT 0,
    user_handle TEXT,
    created_at INTEGER NOT NULL, -- Unix timestamp cuando se guardó
    is_processed INTEGER NOT NULL DEFAULT 0, -- 0 = false, 1 = true
    processing_error TEXT -- Error si falló el procesamiento
);

CREATE INDEX idx_yape_transaction_created_at ON yape_transaction(created_at);
CREATE INDEX idx_yape_transaction_business_name ON yape_transaction(business_name);
CREATE INDEX idx_yape_transaction_is_processed ON yape_transaction(is_processed);

CREATE INDEX idx_yape_notification_created_at ON yape_notification(created_at);
CREATE INDEX idx_yape_notification_package_name ON yape_notification(package_name);
CREATE INDEX idx_yape_notification_is_processed ON yape_notification(is_processed);

-- Queries
selectAllTransactions:
SELECT * FROM yape_transaction 
ORDER BY created_at DESC;

selectTransactionsByBusiness:
SELECT * FROM yape_transaction 
WHERE business_name = ?
ORDER BY created_at DESC;

selectTransactionsByDateRange:
SELECT * FROM yape_transaction 
WHERE created_at BETWEEN ? AND ?
ORDER BY created_at DESC;

selectUnprocessedTransactions:
SELECT * FROM yape_transaction 
WHERE is_processed = 0
ORDER BY created_at DESC;

selectTransactionsByType:
SELECT * FROM yape_transaction 
WHERE transaction_type = ?
ORDER BY created_at DESC;

selectTransactionById:
SELECT * FROM yape_transaction 
WHERE id = ?;

selectTransactionByTransactionId:
SELECT * FROM yape_transaction 
WHERE transaction_id = ?;

insertTransaction:
INSERT INTO yape_transaction (
    transaction_id, amount, currency, sender_name, sender_phone, 
    message, transaction_type, business_name, created_at, 
    processed_at, is_processed, raw_notification, security_code
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateTransactionProcessed:
UPDATE yape_transaction 
SET is_processed = 1, processed_at = ?
WHERE id = ?;

updateTransactionBusiness:
UPDATE yape_transaction 
SET business_name = ?
WHERE id = ?;

deleteTransaction:
DELETE FROM yape_transaction 
WHERE id = ?;

selectTotalAmountByBusiness:
SELECT business_name, SUM(amount), COUNT(*)
FROM yape_transaction 
WHERE transaction_type = 'received' AND is_processed = 1
GROUP BY business_name
ORDER BY SUM(amount) DESC;

selectDailyReport:
SELECT 
    DATE(created_at, 'unixepoch'),
    business_name,
    SUM(amount),
    COUNT(*)
FROM yape_transaction 
WHERE transaction_type = 'received' AND is_processed = 1
GROUP BY DATE(created_at, 'unixepoch'), business_name
ORDER BY DATE(created_at, 'unixepoch') DESC, SUM(amount) DESC;

-- Queries para notificaciones de Yape
selectAllYapeNotifications:
SELECT * FROM yape_notification 
ORDER BY created_at DESC;

selectUnprocessedYapeNotifications:
SELECT * FROM yape_notification 
WHERE is_processed = 0
ORDER BY created_at DESC;

selectYapeNotificationsByDateRange:
SELECT * FROM yape_notification 
WHERE created_at BETWEEN ? AND ?
ORDER BY created_at DESC;

selectYapeNotificationById:
SELECT * FROM yape_notification 
WHERE id = ?;

insertYapeNotification:
INSERT INTO yape_notification (
    package_name, notification_title, notification_text, notification_big_text,
    notification_sub_text, notification_info_text, notification_summary_text,
    notification_ticker_text, notification_extras, notification_id, notification_tag,
    notification_key, notification_timestamp, is_clearable, is_ongoing,
    user_handle, created_at, is_processed, processing_error
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateYapeNotificationProcessed:
UPDATE yape_notification 
SET is_processed = 1, processing_error = ?
WHERE id = ?;

deleteYapeNotification:
DELETE FROM yape_notification 
WHERE id = ?;

selectYapeNotificationStats:
SELECT 
    package_name,
    COUNT(*),
    SUM(CASE WHEN is_processed = 1 THEN 1 ELSE 0 END),
    SUM(CASE WHEN processing_error IS NOT NULL THEN 1 ELSE 0 END)
FROM yape_notification 
GROUP BY package_name
ORDER BY COUNT(*) DESC;
