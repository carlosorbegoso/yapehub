-- Tabla para transacciones de Yape
CREATE TABLE yape_transaction (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    amount REAL NOT NULL,
    security_code TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    sender_name TEXT,
    sender_phone TEXT,
    message TEXT,
    is_confirmed INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Tabla para perfiles de usuario
CREATE TABLE user_profile (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    device_id TEXT NOT NULL UNIQUE,
    role TEXT NOT NULL, -- ADMIN, SELLER
    admin_id TEXT,
    business_name TEXT,
    seller_name TEXT,
    branch_code TEXT,
    branch_name TEXT,
    permissions TEXT, -- JSON string
    subscription_plan TEXT,
    subscription_status TEXT,
    registered_at TEXT,
    last_sync_at TEXT,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Tabla para solicitudes de baja
CREATE TABLE deactivation_request (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    seller_id TEXT NOT NULL,
    seller_name TEXT NOT NULL,
    reason TEXT NOT NULL,
    requested_at TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'PENDING', -- PENDING, APPROVED, REJECTED
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Índices para mejorar el rendimiento
CREATE INDEX idx_yape_transaction_security_code ON yape_transaction(security_code);
CREATE INDEX idx_yape_transaction_timestamp ON yape_transaction(timestamp);
CREATE INDEX idx_yape_transaction_is_confirmed ON yape_transaction(is_confirmed);
CREATE INDEX idx_user_profile_device_id ON user_profile(device_id);
CREATE INDEX idx_user_profile_role ON user_profile(role);
CREATE INDEX idx_deactivation_request_status ON deactivation_request(status);
